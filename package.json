{
  "name": "super-crm",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "tsx scripts/check-layer-boundary.ts && eslint .",
    "lint:boundary": "tsx scripts/check-layer-boundary.ts",
    "test": "tsx scripts/prepare-test-db.ts && vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "tsx scripts/prepare-test-db.ts && vitest run tests/integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-dev.ts",
    "cron": "tsx scripts/cron-scheduler.ts",
    "db:seed:acceptance": "tsx scripts/seed-acceptance.ts",
    "db:seed:demo": "tsx scripts/seed-demo-core.ts",
    "capacity:generate": "tsx scripts/generate-capacity-data.ts",
    "capacity:benchmark": "tsx scripts/benchmark-pools.ts",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:prod": "docker compose up -d",
    "docker:prod:down": "docker compose down"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "dotenv": "16.4.7",
    "drizzle-orm": "0.45.2",
    "jose": "5.9.6",
    "next": "16.3.0",
    "pg": "8.13.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "undici": "6",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.5",
    "@types/pg": "8.11.11",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.26",
      "sharp": "0.35.0"
    }
  },
  "packageManager": "pnpm@9.15.5"
}
