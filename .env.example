# ==============================================================================
# Super CRM (商脉AI CRM) - 生产与开发环境配置模板 (.env.example)
#
# 开源版发行说明 (AGPL-3.0):
#   本模板只包含**核心**与**插件框架**所需变量。
#   7 个业务插件 (bi / contracts / form-capture / knowledge-base / lead-routing /
#   orders / projects) 为闭源组件, 其专属环境变量 (如电子签章 ESIGN_PROVIDER /
#   ESIGN_APP_ID / ESIGN_* 回调) 不在本模板内 —— 开源版不含这些插件, 无需配置。
#   插件框架所需的两个变量 (插件启停 / 插件 API 限流) 无需环境变量, 由
#   plugin_registry 与 plugin_rate_limits 两张表承载。
#
# 生产部署使用指南:
# 1. 复制本文件为生产环境配置文件: cp .env.example .env
# 2. 生成安全生产随机密钥 (在终端执行):
#      SESSION_SECRET: openssl rand -hex 32
#      CRON_SECRET: openssl rand -hex 24
#      POSTGRES_PASSWORD: openssl rand -base64 18
#      APP_DATABASE_PASSWORD: openssl rand -base64 18
# 3. 填入下方生成的密钥后，执行: docker compose up -d
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 运行模式与网络端口
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
APP_HOST_PORT=3000
POSTGRES_HOST_PORT=127.0.0.1:54329

# ------------------------------------------------------------------------------
# 2. PostgreSQL 数据库配置 (生产环境请务必修改密码)
# ------------------------------------------------------------------------------
POSTGRES_DB=salescrm
POSTGRES_USER=salescrm_admin
# 数据库超级管理员/迁移账号密码 (必填，不可使用弱口令)
POSTGRES_PASSWORD=replace_with_strong_pg_admin_password_min_16_chars
# 应用程序专用受限业务账号密码 (必填，不可使用弱口令)
APP_DATABASE_PASSWORD=replace_with_strong_app_db_password_min_16_chars

# Docker 容器内部网络连接串 (通常由 compose 自动基于上方变量拼接)
DATABASE_URL=postgres://salescrm:${APP_DATABASE_PASSWORD}@postgres:5432/salescrm
MIGRATION_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/salescrm

# ------------------------------------------------------------------------------
# 3. 核心应用安全密钥 (生产环境严禁使用默认值)
# ------------------------------------------------------------------------------
# 用户 Session 会话与 Cookie 加密密钥 (必须至少 32 字符，推荐 openssl rand -hex 32)
SESSION_SECRET=replace_with_high_entropy_random_session_secret_at_least_32_chars

# 三方密钥 (AI API Key、Workplace Secret 等) AES-256-GCM 存储加密主密钥 (必须 32 字符，缺省自动从 SESSION_SECRET 派生)
ENCRYPTION_KEY=replace_with_32_chars_master_encryption_key_for_secrets

# 定时巡检与 Cron 触发专用 Bearer Token (推荐 openssl rand -hex 24)
CRON_SECRET=replace_with_high_entropy_cron_secret_token_min_16_chars

# Cron 调度器内部请求基地址与轮询周期 (分钟)
CRON_BASE_URL=http://app:3000
CRON_INTERVAL_MINUTES=5

# ------------------------------------------------------------------------------
# 4. 自动化启动与多副本集群迁移配置
# ------------------------------------------------------------------------------
# 是否在容器启动时自动执行 0000~0077 数据库增量迁移 (已内置 PostgreSQL Advisory Lock 会话锁，多副本安全无竞态)
# 若在 K8s 中使用独立的 initContainer/Job 跑迁移，可设为 false
RUN_MIGRATIONS=true

# 生产环境严禁灌装演示数据，请保持 false；开发测试环境可设为 true
SEED_DEMO=false

# 初始化首个企业管理员账号 (仅在全新空库或需重置管理员时生效)
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=replace_with_initial_admin_password_8_chars_min

# ------------------------------------------------------------------------------
# 5. 本地开发与单元/集成测试配置 (宿主机执行 pnpm test 时使用)
# ------------------------------------------------------------------------------
# 宿主机连接 Docker 暴露端口 (54329) 时的数据库连接串
# DATABASE_URL=postgres://salescrm:salescrm_dev@localhost:54329/salescrm
# MIGRATION_DATABASE_URL=postgres://salescrm_admin:salescrm_migration@localhost:54329/salescrm
TEST_DATABASE_URL=postgres://salescrm:salescrm_dev@localhost:54329/salescrm_test
TEST_MIGRATION_DATABASE_URL=postgres://salescrm_admin:salescrm_migration@localhost:54329/salescrm_test

# ------------------------------------------------------------------------------
# 6. AI 网关受控白名单 (仅用于自建内网 LLM 网关)
# ------------------------------------------------------------------------------
# 允许访问的内网 LLM host 或 host:port 列表（逗号分隔，如 llm-gateway.internal:8080,llm-gateway.internal；留空则严格拦截所有内网私网地址）
# AI_GATEWAY_ALLOW_HOSTS=llm-gateway.internal:8080

# ------------------------------------------------------------------------------
# 7. HTTPS 入口 (Caddy 2 TLS 终止, 仅 docker-compose.prod-tls.yml 需要)
# ------------------------------------------------------------------------------
# 上线必读: 生产模式下 session cookie 带 Secure (src/core/auth/actions.ts 的
# secure: NODE_ENV === "production"), 浏览器只在 HTTPS 下才存/发该 cookie。
# 裸 HTTP 暴露 3000 端口 => 全员无法登录。详见 docs/22 第 9 节。
#
# 启动: docker compose -f docker-compose.yml -f docker-compose.prod-tls.yml up -d
#
# 公网域名 (必填)。需已解析到本机公网 IP, 且 80/443 从公网可达。
# 留空会 fail-fast (compose :? 校验 + Caddyfile 报错), 属刻意设计。
SITE_DOMAIN=replace_with_your_public_domain

# 证书来源, 二选一:
#   internal        -> Caddy 本地 CA 自签 (内网试用/预发, 浏览器提示不受信)
#   ops@example.com -> 公网 ACME + 该邮箱收证书到期/吊销通知 (生产推荐)
# 不要留空: Caddyfile 的 {$VAR:default} 对"已设置为空"不生效, 会让 Caddy 启动失败。
# 留空时由 compose 的 ${SITE_TLS_MODE:-internal} 兜底为 internal。
SITE_TLS_MODE=internal

# Caddy 对外端口 (默认值一般无需改动; 仅当宿主机 80/443 已被占用时改)
# TLS_HOST_PORT=443
# TLS_HOST_PORT_HTTP=80

